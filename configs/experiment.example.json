{
  "schema_version": 1,
  "status": "interface_proposal_not_implemented",
  "notes": "No training CLI exists yet. Null values must be resolved explicitly, not guessed.",
  "seed": 42,
  "dataset_manifest": "datasets.example.json",
  "feature_catalog": "feature_catalog.json",
  "features": {
    "groups": ["wire_length", "loadcell_tension", "relative_angle"],
    "include_timestamp_as_feature": false,
    "require_finite_selected_values": true,
    "reject_duplicate_columns": true
  },
  "targets": {
    "task": "force_load_location",
    "allowed_tasks": ["force_only", "force_load_location"],
    "force": {
      "source": "kalman",
      "frame": "hrm_base",
      "canonical_unit": "N",
      "training_sign_multiplier": 1,
      "source_units_from": "explicit_verified_dataset_manifest",
      "allow_source_or_frame_fallback": false,
      "subtract_calibration_baseline_from_regression_target": false,
      "hard_zero_below_threshold": false
    },
    "experiment_label_column": "contact_segment_id",
    "preserve_original_experiment_label": true,
    "location_id_range": [1, 18],
    "location_loss_condition": "valid_force AND unambiguous_load=1 AND known_location_id",
    "missing_force_label": "unknown_not_unloaded"
  },
  "no_load": {
    "source": "selected_force_target",
    "calibration_manifest_role": "calibration",
    "require_explicit_confirmed_unloaded_intervals": true,
    "baseline": "per_axis_median",
    "method": "joint_max_absolute_residual_quantile",
    "quantile": 0.995,
    "report_quantiles": [0.99, 0.995, 0.999],
    "calibration_artifact": null,
    "threshold_off_N": null,
    "threshold_on_N": null,
    "ambiguous_label_policy": "mask_classification_keep_valid_force_regression"
  },
  "split": {
    "strategy": "grouped_by_trial",
    "group_field": "trial_group_id",
    "train_fraction": 0.8,
    "validation_fraction": 0.1,
    "test_fraction": 0.1,
    "perform_before_scaling_and_windowing": true,
    "allow_overlapping_trials_across_splits": false,
    "on_insufficient_independent_trials": "report_and_require_explicit_evaluation_plan"
  },
  "preprocessing": {
    "input_scaler": "standard_train_only",
    "force_scaler": "standard_train_only",
    "timestamp_storage": "int64_nanoseconds",
    "gap_policy": "split_on_rejected_rows_or_dt_above_factor_times_session_median",
    "gap_factor_candidate": 1.5,
    "max_abs_matching_skew_ms": 25.0,
    "strict_live_causality_checked": false,
    "resampling": "none",
    "fill_missing_with_zero": false
  },
  "sequence": {
    "window_samples": 30,
    "stride_samples": 1,
    "label_position": "last_sample",
    "cross_trial_or_gap_windows": false,
    "state_mode": "reset_each_rolling_window",
    "sampling_rate_Hz": null
  },
  "deployment_convention": {
    "hrm_control_multiplier_after_inverse_scaling": -1,
    "apply_in": "future_HRM_control_code_only",
    "implemented": false
  },
  "model_reference_document": "../docs/MODEL_COMPARISON.md",
  "model": {"name": "mlp"},
  "model_presets": {
    "mlp": {"family": "non_temporal", "hidden_sizes": [128, 64], "activation": "relu"},
    "gru": {"family": "temporal", "hidden_size": 64, "num_layers": 1, "bidirectional": false},
    "lstm": {"family": "temporal", "hidden_size": 64, "num_layers": 1, "bidirectional": false},
    "tcn": {"family": "temporal", "channels": 32, "kernel_size": 3, "dilations": [1, 2, 4], "convolutions_per_block": 2, "causal": true}
  },
  "loss": {
    "force": "smooth_l1_on_standardized_target",
    "load": "binary_cross_entropy_with_logits",
    "location": "cross_entropy_masked_loaded_only",
    "weights": {"force": 1.0, "load": 1.0, "location": 1.0},
    "empty_location_batch_term": 0.0
  },
  "training_candidates": {
    "optimizer": "adamw",
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "batch_size": 128,
    "max_epochs": 100,
    "early_stopping_patience": 15,
    "gradient_clip_norm": 1.0
  },
  "input_ablation_presets": {
    "full": ["wire_length", "loadcell_tension", "relative_angle"],
    "without_angles": ["wire_length", "loadcell_tension"],
    "without_tension": ["wire_length", "relative_angle"],
    "angles_only": ["relative_angle"],
    "tension_only": ["loadcell_tension"],
    "with_velocities": ["wire_length", "loadcell_tension", "relative_angle", "wire_velocity", "relative_angular_velocity"]
  },
  "evaluation": {
    "ablation_samples": "common_eligible_subset",
    "report_per_contact_id": true,
    "load_probability_threshold_candidate": 0.5,
    "benchmark_batch_size": 1,
    "benchmark_devices": ["cpu"],
    "latency_percentiles": [50, 95, 99],
    "compute_p95_budget_ms_candidate": 10.0,
    "parameter_budget_candidate": 100000
  }
}
